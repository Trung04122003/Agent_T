---
// Dev-only RTL smoke test (ROADMAP 5.5): real layout forced to dir="rtl". Never published.
// The Arabic line is a fixed sample to check mixed scripts; it is not content.
import { getCollection } from "astro:content";
import Gate from "../components/Gate.astro";
import Ledger, { type LedgerLabels } from "../components/Ledger.astro";
import Base from "../layouts/Base.astro";
import { t } from "../lib/i18n";

const claims = (await getCollection("claims")).map((e) => e.data);
const keys = ["ledgerHeading", "statusVerified", "viewDeclassified", "classifiedClosed", "redactedLabel", "periodPresent", "evidenceHeading"];
const [heading, verified, viewDeclassified, classifiedClosed, redacted, present, evidence] = await Promise.all(
  keys.map((k) => t(k, "vi")),
);
const labels: LedgerLabels = { heading: heading!, verified: verified!, viewDeclassified: viewDeclassified!, classifiedClosed: classifiedClosed!, redacted: redacted!, present: present!, evidence: evidence! };
---

<Base locale="vi" title="RTL smoke test (dev)" dir="rtl">
  <p class="sample" lang="ar" data-rtl-sample>نص تجريبي للاتجاه من اليمين إلى اليسار — ليس للنشر</p>
  <Gate locale="vi" />
  <Ledger claims={claims} locale="vi" labels={labels} showUnverified={true} />
</Base>

<style>
  .sample {
    max-width: var(--wide);
    margin: calc(var(--space) * 2) auto 0;
    padding-inline: var(--gutter);
    font-size: 1.25rem;
  }
</style>
