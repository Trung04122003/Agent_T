---
// Portrait frame (UX section 5): one image per mode. Built only when both images exist and both
// have alt text in vi and en; until then a neutral, decorative placeholder is shown.
// Images go through astro:assets, which re-encodes them and drops EXIF/GPS (check-leaks verifies).
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import placeholder from "../assets/portrait/placeholder.jpg";
import { t, type Locale } from "../lib/i18n";
import { usePhotos, type PortraitAlt } from "../lib/portrait";

interface Props {
  locale: Locale;
  mat?: ImageMetadata;
  giaiMat?: ImageMetadata;
  alt?: PortraitAlt;
}
const { locale, mat, giaiMat, alt } = Astro.props;

const hasPhotos = usePhotos(mat, giaiMat, alt);
const label = await t("portraitLabel", locale);

// Viewfinder (ROADMAP 13.4), Mat only: vector lines over the frame, in a 400 x 500 box (4:5).
const W = 400;
const H = 500;
const ticks = (len: number, step: number) => Array.from({ length: Math.floor(len / step) - 1 }, (_, i) => (i + 1) * step);

const picture = {
  formats: ["avif", "webp"] as ("avif" | "webp")[],
  fallbackFormat: "webp" as const,
  widths: [480, 800, 1200],
  sizes: "(min-width: 900px) 40vw, 100vw",
};
---

<div class="portrait brackets" data-portrait>
  <p class="portrait__label">{label}</p>
  {
    hasPhotos && mat && giaiMat && alt ? (
      <>
        <Picture
          {...picture}
          src={mat}
          alt={alt.mat[locale]}
          class="portrait__img"
          pictureAttributes={{ class: "portrait__pic--mat" }}
          loading="eager"
        />
        <Picture
          {...picture}
          src={giaiMat}
          alt={alt.giaiMat[locale]}
          class="portrait__img"
          pictureAttributes={{ class: "portrait__pic--giai-mat" }}
          loading="lazy"
        />
      </>
    ) : (
      <Picture {...picture} src={placeholder} alt="" class="portrait__img" loading="eager" data-placeholder />
    )
  }
  <svg class="portrait__finder only-mat" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false" data-finder>
    <!-- Edge rulers: short ticks every 20, long every 100. -->
    <g class="finder__ticks">
      {ticks(H, 20).map((y) => <line x1="0" y1={y} x2={y % 100 ? 6 : 14} y2={y} />)}
      {ticks(H, 20).map((y) => <line x1={W} y1={y} x2={W - (y % 100 ? 6 : 14)} y2={y} />)}
      {ticks(W, 20).map((x) => <line x1={x} y1={H} x2={x} y2={H - (x % 100 ? 6 : 14)} />)}
    </g>
    <!-- Thirds: small crosses where the lines would meet. -->
    <g class="finder__thirds">
      {
        [W / 3, (2 * W) / 3].flatMap((x) =>
          [H / 3, (2 * H) / 3].map((y) => <path d={`M${x - 6} ${y}h12M${x} ${y - 6}v12`} />),
        )
      }
    </g>
    <!-- Centre reticle: ring, broken crosshair, four inner ticks. -->
    <g class="finder__reticle" transform={`translate(${W / 2} ${H / 2})`}>
      <circle r="34" />
      <circle r="2" class="finder__dot" />
      <path d="M-90 0h46M44 0h46M0 -90v46M0 44v46" />
      <path d="M-34 0h8M26 0h8M0 -34v8M0 26v8" />
    </g>
  </svg>
</div>

<style>
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }
  /* Frame label (monospace); the corners are the shared .brackets (UX-v2 section 3). */
  .portrait__label {
    position: absolute;
    z-index: 1;
    top: calc(var(--space) * 1.5);
    inset-inline-start: calc(var(--space) * 1.5);
    margin: 0;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--surface);
  }
  .portrait__finder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
  }
  .portrait__finder :is(line, path, circle) {
    vector-effect: non-scaling-stroke;
  }
  .finder__ticks,
  .finder__thirds {
    opacity: 0.55;
  }
  .finder__dot {
    fill: var(--accent);
  }
  .portrait :global(img[data-placeholder]) {
    opacity: 0.25;
  }
  .portrait :global(picture),
  .portrait :global(.portrait__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(:root[data-mode="mat"]) .portrait :global(.portrait__pic--giai-mat),
  :global(:root[data-mode="giai-mat"]) .portrait :global(.portrait__pic--mat) {
    display: none;
  }
  /* Print is always Giai mat (UX section 4). */
  @media print {
    :global(:root[data-mode]) .portrait :global(.portrait__pic--mat) {
      display: none;
    }
    :global(:root[data-mode]) .portrait :global(.portrait__pic--giai-mat) {
      display: block;
    }
  }
</style>
