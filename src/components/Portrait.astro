---
// Portrait frame (UX section 5): one image per mode. Built only when both images exist and both
// have alt text in vi and en; until then the empty frame with its viewfinder is shown.
// The photos (ROADMAP P29) are the owner's one session, processed by tools/portrait/build.mjs into
// public/portrait/ (AVIF, WebP, JPEG; 480, 720 and 960 wide; no metadata, check-leaks verifies): "low"
// for Mat, "high-b" for Giai mat. Labels and alt text: content/portrait.json.
import { existsSync } from "node:fs";
import portraitJson from "../../content/portrait.json";
import { t, type Locale } from "../lib/i18n";
import { usePhotos } from "../lib/portrait";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const PHOTOS = { mat: "low", giaiMat: "high-b" } as const;
const have = (name: string) => existsSync(`public/portrait/${name}-960.jpg`);
const hasPhotos = usePhotos(have(PHOTOS.mat) || undefined, have(PHOTOS.giaiMat) || undefined, portraitJson.alt);
const label = await t("portraitLabel", locale);
/** srcset for one variant and format: 480, 720 and 960 wide (tools/portrait/build.mjs). */
const set = (name: string, ext: string) => [480, 720, 960].map((w) => `/portrait/${name}-${w}.${ext} ${w}w`).join(", ");

// Viewfinder (ROADMAP 13.4), Mat only: vector lines over the frame, in a 400 x 500 box (4:5).
const W = 400;
const H = 500;
const ticks = (len: number, step: number) => Array.from({ length: Math.floor(len / step) - 1 }, (_, i) => (i + 1) * step);

// The frame is 40vw from 900 px (473 px at 1280), the full column below.
const picture = { sizes: "(min-width: 900px) 40vw, 100vw" };
---

<div class="portrait brackets" data-portrait>
  {
    hasPhotos ? (
      <p class="portrait__label">
        <span class="only-mat">{portraitJson.label.mat[locale]}</span>
        <span class="only-giai-mat">{portraitJson.label.giaiMat[locale]}</span>
      </p>
    ) : (
      <p class="portrait__label">{label}</p>
    )
  }
  {
    hasPhotos ? (
      <>
        {/* Mat: the first image the reader sees, so the one fetched first (ROADMAP 29.7). */}
        <picture class="portrait__pic--mat">
          <source type="image/avif" srcset={set(PHOTOS.mat, "avif")} sizes={picture.sizes} />
          <source type="image/webp" srcset={set(PHOTOS.mat, "webp")} sizes={picture.sizes} />
          <img
            class="portrait__img"
            src={`/portrait/${PHOTOS.mat}-960.jpg`}
            srcset={set(PHOTOS.mat, "jpg")}
            sizes={picture.sizes}
            alt={portraitJson.alt.mat[locale]}
            width="960"
            height="1200"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
        {/* Giai mat: lazy, then fetched when the browser is idle (script below), ready for Declassify. */}
        <picture class="portrait__pic--giai-mat">
          <source type="image/avif" srcset={set(PHOTOS.giaiMat, "avif")} sizes={picture.sizes} />
          <source type="image/webp" srcset={set(PHOTOS.giaiMat, "webp")} sizes={picture.sizes} />
          <img
            class="portrait__img"
            src={`/portrait/${PHOTOS.giaiMat}-960.jpg`}
            srcset={set(PHOTOS.giaiMat, "jpg")}
            sizes={picture.sizes}
            alt={portraitJson.alt.giaiMat[locale]}
            width="960"
            height="1200"
            decoding="async"
            loading="lazy"
            fetchpriority="low"
            data-portrait-later
          />
        </picture>
      </>
    ) : null
  }
  {/* Mat only over a real photo; without photos it fills the empty frame in both modes (ROADMAP 20.5). */}
  <svg class:list={["portrait__finder", hasPhotos && "only-mat"]} viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false" data-finder>
    <!-- Edge rulers: short ticks every 20, long every 100. -->
    <g class="finder__ticks">
      {ticks(H, 20).map((y) => <line x1="0" y1={y} x2={y % 100 ? 6 : 14} y2={y} />)}
      {ticks(H, 20).map((y) => <line x1={W} y1={y} x2={W - (y % 100 ? 6 : 14)} y2={y} />)}
      {ticks(W, 20).map((x) => <line x1={x} y1={H} x2={x} y2={H - (x % 100 ? 6 : 14)} />)}
    </g>
    <!-- Thirds: small crosses where the lines would meet. -->
    <g class="finder__thirds">
      {
        [W / 3, (2 * W) / 3].flatMap((x) =>
          [H / 3, (2 * H) / 3].map((y) => <path d={`M${x - 6} ${y}h12M${x} ${y - 6}v12`} />),
        )
      }
    </g>
    <!-- Centre reticle: ring, broken crosshair, four inner ticks. -->
    <g class="finder__reticle" transform={`translate(${W / 2} ${H / 2})`}>
      <circle r="34" />
      <circle r="2" class="finder__dot" />
      <path d="M-90 0h46M44 0h46M0 -90v46M0 44v46" />
      <path d="M-34 0h8M26 0h8M0 -34v8M0 26v8" />
    </g>
  </svg>
</div>

<script>
  // ROADMAP 29.7: the Giai mat photo waits until the page is idle, then is fetched, so the switch
  // to Giai mat never waits for it. (Without JS it stays lazy: shown when its mode is.)
  const later = () => {
    for (const img of document.querySelectorAll<HTMLImageElement>("img[data-portrait-later]")) img.loading = "eager";
  };
  const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(later, { timeout: 3000 }) : setTimeout(later, 1500));
  if (document.readyState === "complete") idle();
  else addEventListener("load", idle, { once: true });
</script>

<style>
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }
  /* Frame label (monospace); the corners are the shared .brackets (UX-v2 section 3). */
  .portrait__label {
    position: absolute;
    z-index: 1;
    top: calc(var(--space) * 1.5);
    inset-inline-start: calc(var(--space) * 1.5);
    margin: 0;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--surface);
  }
  .portrait__finder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
  }
  .portrait__finder :is(line, path, circle) {
    vector-effect: non-scaling-stroke;
  }
  .finder__ticks,
  .finder__thirds {
    opacity: 0.55;
  }
  .finder__dot {
    fill: var(--accent);
  }
  .portrait :global(picture),
  .portrait :global(.portrait__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(:root[data-mode="mat"]) .portrait :global(.portrait__pic--giai-mat),
  :global(:root[data-mode="giai-mat"]) .portrait :global(.portrait__pic--mat) {
    display: none;
  }
  /* Print is always Giai mat (UX section 4). */
  @media print {
    :global(:root[data-mode]) .portrait :global(.portrait__pic--mat) {
      display: none;
    }
    :global(:root[data-mode]) .portrait :global(.portrait__pic--giai-mat) {
      display: block;
    }
  }
</style>
