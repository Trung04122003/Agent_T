---
// Four-point map (SPEC section 8). Static SVG built from Natural Earth (Viet Nam point of view);
// Hoang Sa and Truong Sa are always drawn and labelled. No tiles, no third-party requests.
// The drawing is decorative for screen readers: the legend list beside it carries the same
// places as text, and its buttons drive the map (highlight, zoom to a place).
import { getCollection } from "astro:content";
import placesFile from "../../content/places.json";
import admin from "../../content/provinces.json";
import topo from "../assets/map/region.topo.json";
import { t, type Locale } from "../lib/i18n";
import { inFileOrder } from "../lib/ledger";
import { buildMap, VIEW } from "../lib/map";
import PageMark from "./PageMark.astro";
import type { Topology } from "topojson-specification";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// Collections do not keep file order; the owner's order drives the list and the reveal sequence.
const places = inFileOrder(
  (await getCollection("places")).map((e) => e.data),
  placesFile.map((p) => p.id),
);
const map = buildMap(
  topo as unknown as Topology,
  places.map((p) => ({ id: p.id, lat: p.approx.lat, lon: p.approx.lon, text: p.label[locale] })),
  admin,
);
// Two modes of the province layer (owner request 2026-10-29): the 63 provinces before the 2025
// merger, the 34 after (default, as today). Names come from content/provinces.json.
const before = new Map(admin.before.map((b) => [b.code, b[locale]]));
const after = new Map(admin.after.map((a) => [a.id, a[locale]]));
const era = { label: await t("mapEraLabel", locale), before: await t("mapEraBefore", locale), after: await t("mapEraAfter", locale) };
const capital = await t("mapCapital", locale);
const stepIds = ["sea", "world", "base", "near", "home"] as const;
const steps = {
  items: await Promise.all(stepIds.map(async (id) => ({ id, text: await t(`mapStep${id[0]!.toUpperCase()}${id.slice(1)}`, locale) }))),
};
const view = { label: await t("mapViewLabel", locale), flat: await t("mapViewFlat", locale), terraced: await t("mapViewTerraced", locale) };
// Five-pointed star, outer radius 6.5, point up.
const star =
  Array.from({ length: 10 }, (_, i) => {
    const r = i % 2 ? 2.7 : 6.5;
    const a = (i * Math.PI) / 5 - Math.PI / 2;
    return `${i ? "L" : "M"}${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  }).join("") + "Z";
const heading = await t("mapHeading", locale);
const title = await t("mapTitle", locale);
const roles = {
  origin: await t("placeRoleOrigin", locale),
  current: await t("placeRoleCurrent", locale),
  home: await t("placeRoleHome", locale),
};
const zoom = { in: await t("mapZoomIn", locale), out: await t("mapZoomOut", locale), reset: await t("mapReset", locale) };
const hoangSa = await t("hoangSaLabel", locale);
const truongSa = await t("truongSaLabel", locale);
const credit = await t("mapCredit", locale);
const vn = map.countries.find((c) => c.code === "VNM")!;
const others = map.countries.filter((c) => c.code !== "VNM");
const place = (id: string) => places.find((p) => p.id === id)!;
const seas = [
  { id: "hoang-sa", text: hoangSa, ...map.archipelagos.hoangSa },
  { id: "truong-sa", text: truongSa, ...map.archipelagos.truongSa },
];
---

<section class="map sheet sheet--block" aria-labelledby="map-title" data-map data-era="after" data-view="2d">
  <PageMark locale={locale} page="map" />
  <p class="map__kicker">{heading}</p>
  <h2 id="map-title" class="map__title">{title}</h2>
  <div class="map__body">
    <div class="map__side">
    <div class="map__era" role="group" aria-label={era.label} data-map-era hidden>
      <button type="button" data-era-btn="before" aria-pressed="false">{era.before}</button>
      <button type="button" data-era-btn="after" aria-pressed="true">{era.after}</button>
    </div>
    {/* Narrow screens: one map at a time. From 1280 px both stand side by side and this hides. */}
    <div class="map__era map__view" role="group" aria-label={view.label} data-map-view hidden>
      <button type="button" data-view-btn="2d" aria-pressed="true">{view.flat}</button>
      <button type="button" data-view-btn="3d" aria-pressed="false">{view.terraced}</button>
    </div>
    <ul class="map__legend" data-map-list>
      {
        places.map((p) => (
          <li>
            <button type="button" class="map__place" data-place-btn={p.id} aria-pressed="false">
              <span class={`map__marker map__marker--${p.role}`} aria-hidden="true" />
              <span class="map__place-name">
                {p.label[locale]}
                {p.region && `, ${p.region[locale]}`}
              </span>
              <span class="map__place-role">
                <span class="visually-hidden"> — </span>
                {roles[p.role]}
              </span>
            </button>
          </li>
        ))
      }
      <li class="map__key">
        <span class="map__key-star" aria-hidden="true"></span>
        {capital}
      </li>
      <li class="map__sea">{hoangSa}</li>
      <li class="map__sea">{truongSa}</li>
    </ul>
    </div>
    <div class="map__frame brackets" data-map-frame>
      <svg class="map__svg" viewBox={`0 0 ${VIEW.width} ${VIEW.height}`} aria-hidden="true" focusable="false" data-map-svg>
        <g class="map__land">{others.map((c) => <path d={c.d} />)}</g>
        {/* Fills per former province, stepped by brightness (sea, other countries, Viet Nam, next to
            home, home); the step and the hover name follow the mode. */}
        <g class="map__provinces" data-map-provinces>
          {
            map.provinces.map((p) => (
              <path d={p.d} data-code={p.code} data-unit={p.after} data-tb={p.tier.before} data-ta={p.tier.after} data-name={before.get(p.code)} data-unit-name={after.get(p.after)} />
            ))
          }
        </g>
        <path class="map__border map__border--merged" d={map.borders.merged} />
        <path class="map__border" d={map.borders.kept} />
        <path class="map__vn" d={vn.d} pathLength="1" />
        <g class="map__islands">
          {
            [...map.archipelagos.hoangSa.dots, ...map.archipelagos.truongSa.dots].map(([x, y]) => (
              <circle class="map__isle-pad" cx={x} cy={y} r="3.4" />
            ))
          }
          {
            [...map.archipelagos.hoangSa.dots, ...map.archipelagos.truongSa.dots].map(([x, y]) => (
              <circle cx={x} cy={y} r="1.6" />
            ))
          }
        </g>
        {
          seas.map((s) => (
            <g transform={`translate(${s.label[0]} ${s.label[1]})`}>
              <text class="map__sea-label map__fixed" text-anchor={s.anchor} data-archipelago={s.id}>
                {s.text}
              </text>
            </g>
          ))
        }
        <g class="map__points">
          {
            map.points.map((p, i) => {
              const { role, label } = place(p.id);
              return (
                <g class={`map__point map__point--${role}`} style={`--i:${i}`} transform={`translate(${p.x} ${p.y})`} data-place={p.id}>
                  {/* Counter-scaled while zoomed: marks and labels keep their size on screen. */}
                  <g class="map__fixed">
                    {/* Viewfinder on the active place (ROADMAP 13.4), Mat only: ring and crosshair. */}
                    <g class="map__reticle">
                      <path class="map__cross" d="M-2000 0H-22M22 0H2000M0 -2000V-22M0 22V2000" />
                      <circle r="15" />
                      <path d="M-15 0h6M9 0h6M0 -15v6M0 9v6" />
                    </g>
                    <circle class="map__halo" r="4" />
                    {role === "origin" && <circle class="map__ring" r="7" />}
                    <circle class="map__dot" r={role === "current" ? 5.5 : 4} />
                    {/* Spot chosen at build so no label covers another (ROADMAP 20.4); the role is in the list only. */}
                    <text x={p.label.dx} y={p.label.dy} text-anchor={p.label.anchor}>
                      {label[locale]}
                    </text>
                  </g>
                </g>
              );
            })
          }
        </g>
        {/* On top of the points: 18 km from Thuong Tin, it would hide under that ring at full view. */}
        <g class="map__capital" transform={`translate(${map.capital[0]} ${map.capital[1]})`}>
          <path class="map__fixed" d={star} />
        </g>
      </svg>
      <p class="map__readout" data-map-readout aria-hidden="true" hidden><span data-readout-name></span><span class="map__readout-sub" data-readout-sub></span></p>
      <div class="map__zoom" data-map-zoom hidden>
        <button type="button" data-zoom="in" aria-label={zoom.in} title={zoom.in}>+</button>
        <button type="button" data-zoom="out" aria-label={zoom.out} title={zoom.out}>−</button>
        <button type="button" data-zoom="reset" aria-label={zoom.reset} title={zoom.reset}>⟲</button>
      </div>
    </div>
    {/* Terraced 3D view (owner request 2026-11-01): built by map-3d.ts from the drawing above, with JS only. */}
    <div class="map__terraced" data-map-3d data-focus={map.focus.join(" ")} hidden>
      <div class="map__frame map__frame--3d brackets">
        <svg class="map__svg map__svg--3d" aria-hidden="true" focusable="false" data-map-3d-svg></svg>
        <p class="map__readout" data-map-readout aria-hidden="true" hidden><span data-readout-name></span><span class="map__readout-sub" data-readout-sub></span></p>
      </div>
      {/* The steps, low to high: what the heights (and the 2D brightness) mean. It explains the
          drawings, which screen readers skip, so it is skipped too (the legend list carries the places). */}
      <ol class="map__steps" aria-hidden="true">
        {steps.items.map((s) => (
          <li><span class={`map__step map__step--${s.id}`} aria-hidden="true" />{s.text}</li>
        ))}
      </ol>
    </div>
  </div>
  <p class="map__credit" lang="en"><a href="https://www.naturalearthdata.com/">{credit}</a></p>
</section>

<script>
  import { initMap } from "../scripts/map-reveal";
  import { initMapView } from "../scripts/map-view";
  initMap();
  initMapView();
</script>

<style>
  .map__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .map__title {
    margin: var(--space) 0 calc(var(--space) * 3);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .map__body {
    display: grid;
    gap: calc(var(--space) * 3);
  }
  @media (min-width: 900px) {
    .map__body {
      grid-template-columns: minmax(0, 600px) minmax(0, 1fr);
      align-items: start;
    }
    /* The legend comes first in the source (read before the map controls), right of the map here. */
    .map__side {
      grid-column: 2;
      grid-row: 1;
    }
  }
  /* Narrow screens: one map at a time (the 2D/3D buttons). */
  .map[data-view="2d"] .map__terraced,
  .map[data-view="3d"] [data-map-frame] {
    display: none;
  }
  .map__terraced:not([hidden]) {
    display: grid;
    align-content: start;
    gap: calc(var(--space) * 2);
  }
  /* Step key: five swatches, darkest to brightest, in this mode's colours. */
  .map__steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space) calc(var(--space) * 2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .map__steps li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .map__step {
    width: 14px;
    height: 10px;
    border: 1px solid var(--line);
    background: var(--t-base);
  }
  .map__step--sea {
    background: var(--t-sea);
  }
  .map__step--world {
    background: var(--t-world);
  }
  .map__step--near {
    background: var(--t-near);
  }
  .map__step--home {
    background: var(--t-home);
  }
  /* From 1280 px the flat and the terraced map stand side by side (owner's choice, 2026-11-01);
     the controls and the legend run across the top. */
  @media (min-width: 1280px) {
    .map__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .map__side {
      grid-column: 1 / -1;
      grid-row: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space) calc(var(--space) * 3);
    }
    .map__legend {
      grid-column: 1 / -1;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
    .map .map__view {
      display: none;
    }
    .map[data-view] [data-map-frame] {
      display: block;
    }
    .map[data-view] .map__terraced:not([hidden]) {
      display: grid;
    }
  }
  @media print {
    .map .map__terraced {
      display: none;
    }
    .map[data-view] [data-map-frame] {
      display: block;
    }
  }

  /* The map's own frame: hairline border, accent corners, ruler ticks on the edges. It is cut off
     from the page grid (solid ground) and clips the zoomed drawing. */
  .map {
    /* Terraced brightness (owner's idea after the Cao Bang rice terraces, 2026-10-29): five flat
       steps from the sea up to the home provinces, all mixed from this mode's accent and paper.
       Giai mat: brightest is the white sheet. */
    --t-sea: color-mix(in oklab, var(--accent) 24%, var(--bg));
    --t-world: color-mix(in oklab, var(--accent) 14%, var(--bg));
    --t-base: color-mix(in oklab, var(--accent) 6%, var(--bg));
    --t-near: color-mix(in oklab, var(--bg) 45%, var(--surface));
    --t-home: var(--surface);
    --t-hot: color-mix(in oklab, var(--accent) 22%, var(--surface));
    --t-border: color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .map__frame {
    background-color: var(--t-sea);
    border: 1px solid var(--line);
  }
  .map__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 32px) top / 100% 6px no-repeat,
      repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 32px) bottom / 100% 6px no-repeat,
      repeating-linear-gradient(var(--line) 0 1px, transparent 1px 32px) left / 6px 100% no-repeat,
      repeating-linear-gradient(var(--line) 0 1px, transparent 1px 32px) right / 6px 100% no-repeat;
  }
  .map__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }
  .map.is-zoomed .map__svg {
    cursor: grab;
    touch-action: none; /* drag pans the map; at full view the page scrolls as usual */
  }
  .map.is-dragging .map__svg {
    cursor: grabbing;
  }
  /* Mode of the province layer: two pressed-or-not buttons (shown with JS only). */
  .map__era {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-block-end: var(--space);
  }
  .map__era[hidden] {
    display: none;
  }
  .map__era button {
    min-height: var(--target);
    padding: 4px var(--space);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
  }
  .map__era button:hover {
    border-color: var(--accent);
  }
  .map__era button[aria-pressed="true"] {
    color: var(--ink);
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  /* Name of the province under the pointer, in the frame's top corner. */
  .map__readout {
    position: absolute;
    inset-block-start: calc(var(--space) * 1.5);
    inset-inline-start: calc(var(--space) * 1.5);
    z-index: 2;
    display: grid;
    max-width: 60%;
    margin: 0;
    padding: 4px var(--space);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 2px;
    pointer-events: none;
  }
  .map__readout[hidden] {
    display: none;
  }
  .map__readout-sub {
    font-weight: 400;
    color: var(--ink-muted);
  }
  .map__readout-sub:empty {
    display: none;
  }
  .map__zoom {
    position: absolute;
    /* Bottom corner: tabbed after the legend, which sits beside the top of the map on desktop. */
    inset-block-end: calc(var(--space) * 1.5);
    inset-inline-end: calc(var(--space) * 1.5);
    z-index: 2;
    display: grid;
    gap: 4px;
  }
  .map__zoom button {
    width: var(--target);
    height: var(--target);
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
  }
  .map__zoom button:hover:not(:disabled) {
    border-color: var(--accent);
  }
  .map__zoom button:disabled {
    color: var(--ink-muted);
    cursor: default;
  }

  /* Legend: the places as text, each one a button that finds it on the map. */
  .map__legend {
    display: grid;
    gap: var(--space);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .map__place {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    column-gap: var(--space);
    align-items: center;
    width: 100%;
    min-height: var(--target);
    padding: var(--space) calc(var(--space) * 1.5);
    font: inherit;
    text-align: start;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
  }
  .map__place:hover,
  .map__place.is-active {
    border-color: var(--accent);
  }
  .map__place[aria-pressed="true"] {
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .map__place-name {
    font-weight: 700;
  }
  .map__place-role {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .map__marker {
    grid-row: 1 / span 2;
    justify-self: center;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
  }
  /* Markers match the map: ring = family hometown, large dot = where the owner lives now. */
  .map__marker--current {
    width: 12px;
    height: 12px;
  }
  .map__marker--origin {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 3px var(--accent);
  }
  .map__key {
    display: flex;
    align-items: center;
    gap: var(--space);
    padding-inline-start: calc(var(--space) * 1.5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink);
  }
  /* Same star as on the map (outer radius 6.5, inner 2.7 of 7), cut from a square. */
  .map__key-star {
    width: 14px;
    height: 14px;
    background: var(--accent);
    clip-path: polygon(50% 3.6%, 61.3% 34.4%, 94.2% 35.7%, 68.3% 56%, 77.3% 87.6%, 50% 69.3%, 22.7% 87.6%, 31.7% 56%, 5.8% 35.7%, 38.7% 34.4%);
  }
  @media (forced-colors: active) {
    .map__key-star {
      background: CanvasText;
    }
  }
  .map__sea {
    padding-inline-start: calc(var(--space) * 1.5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  @media (forced-colors: active) {
    .map__marker {
      background: CanvasText;
    }
  }

  .map__credit {
    margin: calc(var(--space) * 2) 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }
  .map__credit a {
    color: inherit;
    text-underline-offset: 3px;
  }

  /* Drawing. --k is the zoom factor (set by map-view.ts): strokes, dots and labels are divided by
     it so they keep their screen size while the land gets bigger. */
  .map__land path {
    fill: var(--t-world);
    stroke: var(--line);
    stroke-width: calc(0.6px / var(--k, 1));
  }
  /* Each fill strokes in its own colour too, so no hairline gap shows between two provinces. */
  .map__provinces path {
    color: var(--t-base);
    fill: currentColor;
    stroke: currentColor;
    stroke-width: calc(0.5px / var(--k, 1));
  }
  .map[data-era="before"] :global([data-tb="near"]),
  .map[data-era="after"] :global([data-ta="near"]) {
    color: var(--t-near);
  }
  .map[data-era="before"] :global([data-tb="home"]),
  .map[data-era="after"] :global([data-ta="home"]) {
    color: var(--t-home);
  }
  .map .map__provinces path.is-hot {
    color: var(--t-hot);
  }
  .map__border {
    fill: none;
    stroke: var(--t-border);
    stroke-width: calc(0.6px / var(--k, 1));
    stroke-linejoin: round;
  }
  .map[data-era="after"] .map__border--merged {
    display: none;
  }
  .map__border,
  .map__vn,
  .map__islands,
  .map__capital {
    pointer-events: none;
  }
  /* Terraced 3D view (map-3d.ts). Tops take the step colours of the 2D map (same data-tb/data-ta);
     risers are the same colour sunk towards the sea, so each step reads as a wall. */
  .map__svg--3d :global(.map3d__top) {
    color: var(--t-base);
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.5px;
  }
  .map__svg--3d :global(.map3d__wall) {
    color: var(--t-base);
    fill: color-mix(in oklab, currentColor calc(20% + var(--lift, 0) * 45%), var(--t-sea));
    pointer-events: none;
  }
  .map__svg--3d :global(.map3d__world) {
    fill: var(--t-world);
    stroke: var(--line);
    stroke-width: 0.5px;
  }
  .map__svg--3d :global(.map3d__wall--world) {
    fill: color-mix(in oklab, var(--t-world) 55%, var(--t-sea));
