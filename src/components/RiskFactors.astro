---
// "Limits and risks" (ROADMAP 17.3), the owner's own words about themself, in the manner of a
// prospectus's risk factors: each item a risk and how it is reduced. Claude Code only builds the
// frame; with no item in content/risks.json the section is not rendered.
import { t, type Locale } from "../lib/i18n";
import { orderedRisks } from "../lib/risks";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const risks = await orderedRisks();
const [kicker, heading, riskLabel, mitigation] =
  risks.length > 0 ? await Promise.all(["risksKicker", "risksHeading", "riskLabel", "mitigationLabel"].map((k) => t(k, locale))) : [];
---

{
  risks.length > 0 && (
    <section class="risks sheet sheet--block" aria-labelledby="risks-heading" data-risks>
      <p class="risks__kicker">{kicker}</p>
      <h2 id="risks-heading" class="risks__heading">
        {heading}
      </h2>
      <ol class="risks__list">
        {risks.map((r, i) => (
          <li class="risks__item" data-risk={r.id}>
            <span class="risks__no" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            {/* An item with a Mat wording shows it in Mat and the plain one in Giai mat and print. */}
            {[
              { text: r, cls: r.mat ? "only-giai-mat" : undefined },
              ...(r.mat ? [{ text: r.mat, cls: "only-mat" }] : []),
            ].map(({ text, cls }) => (
              <div class:list={["risks__body", cls]} data-risk-version={cls === "only-mat" ? "mat" : "plain"}>
                <p class="risks__risk">
                  <span class="visually-hidden">{riskLabel}: </span>
                  {text.risk[locale]}
                </p>
                <p class="risks__mitigation">
                  <span class="risks__tag">{mitigation}</span>
                  {text.mitigation[locale]}
                </p>
              </div>
            ))}
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .risks__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .risks__heading {
    margin: var(--space) 0 calc(var(--space) * 3);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .risks__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--accent);
  }
  .risks__item {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr);
    gap: calc(var(--space) * 2);
    padding: calc(var(--space) * 2) 0;
    border-bottom: 1px solid var(--line);
  }
  .risks__no {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }
  .risks__body {
    display: grid;
    gap: var(--space);
    max-width: var(--measure);
  }
  @media (min-width: 900px) {
    .risks__body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: calc(var(--space) * 4);
      max-width: none;
    }
  }
  .risks__risk,
  .risks__mitigation {
    margin: 0;
  }
  .risks__risk {
    font-weight: 700;
  }
  .risks__tag {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
