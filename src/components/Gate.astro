---
import { t, type Locale } from "../lib/i18n";
import { codenameFor, getIdentity } from "../lib/identity";
import { getLenses } from "../lib/lenses";
import PageMark from "./PageMark.astro";
import Portrait from "./Portrait.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const identity = await getIdentity();
const codename = codenameFor(identity, locale);
const codenameLabel = await t("codenameLabel", locale);
const scrollHint = await t("gateScrollHint", locale);
const legalNameLabel = await t("legalNameRedacted", locale);
const seal = await t("sealDeclassified", locale);
const lensLines = getLenses().flatMap((l) => (l.positioning ? [{ id: l.id, positioning: l.positioning, mat: l.positioningMat }] : []));
---

<!-- Level 0 (SPEC section 4): codename, positioning line, portrait. Nothing else. -->
<section class="gate" data-level0 aria-labelledby="gate-codename">
  <div class="gate__id sheet">
    <PageMark locale={locale} page="gate" />
    {/* Giai mat seal (ROADMAP 28.5): decorative, the mode switch already announces the level. */}
    <p class="gate__seal only-giai-mat" aria-hidden="true" data-seal>{seal}</p>
    <p class="gate__label">{codenameLabel}</p>
    <h1 id="gate-codename" class="gate__codename">{codename.name}</h1>
    {codename.positioning && <p class="gate__codename-line">{codename.positioning}</p>}
    <!-- Legal name, option B (owner 2026-10-24): a fixed-length bar in Mat, the name in Giai mat.
         The name is public, so it stays in the HTML; the bar itself holds no text. -->
    <p class="gate__legal" data-legal-name>
      <span class="redact" role="img" aria-label={legalNameLabel}></span>
      <span class="gate__legal-name">{identity.legalName}</span>
    </p>
    <!-- Two wordings when the owner gave a Mat one: Mat in Mat, the plain line in Giai mat (and
         without JS, where the Giai mat version shows). -->
    <p class:list={["gate__positioning", identity.positioningMat && "only-giai-mat"]} data-positioning="plain">
      {identity.positioning[locale]}
    </p>
    {
      identity.positioningMat && (
        <p class="gate__positioning only-mat" data-positioning="mat">
          {identity.positioningMat[locale]}
        </p>
      )
    }
    {/* ROADMAP 25.7: a line per reader where the owner wrote one; lens.ts shows it in place of the
        common line(s) while that lens is chosen. Without JS or a lens, the common line stays. */}
    {
      lensLines.map((l) => (
        <>
          {/* Two wordings, like the common line: the mysterious one in Mat, the plain one in Giai mat. */}
          <p class:list={["gate__positioning", l.mat && "only-giai-mat"]} data-positioning-lens={l.id} hidden>
            {l.positioning[locale]}
          </p>
          {l.mat && (
            <p class="gate__positioning only-mat" data-positioning-lens={l.id} hidden>
              {l.mat[locale]}
            </p>
          )}
        </>
      ))
    }
  </div>
  <div class="gate__portrait">
    <Portrait locale={locale} />
  </div>
  <p class="gate__hint">{scrollHint}</p>
</section>

<style>
  .gate__seal {
    position: absolute;
    inset-block-start: calc(var(--space) * 2.5);
    inset-inline-end: calc(var(--space) * 2.5);
    margin: 0;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border: 2px solid currentColor;
    border-radius: 2px;
    transform: rotate(-8deg);
    opacity: 0.85;
    pointer-events: none;
  }
  .gate {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--space) * 4);
    align-content: center;
    min-height: calc(100svh - var(--bar-height));
    max-width: var(--wide);
    margin-inline: auto;
    padding: calc(var(--space) * 4) var(--gutter);
  }
  /* Phone: portrait first, then the name (UX section 4). */
  .gate__portrait {
    order: -1;
  }
  @media (min-width: 900px) {
    .gate {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: calc(var(--space) * 3);
      align-items: center;
    }
    .gate__id {
      grid-column: 1 / span 7;
    }
    .gate__portrait {
      order: 0;
      grid-column: 8 / span 5;
    }
    .gate__hint {
      grid-column: 1 / -1;
    }
  }

  .gate__label,
  .gate__hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .gate__codename {
    margin: var(--space) 0 0;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 12vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .gate__codename-line {
    margin: var(--space) 0 0;
    color: var(--ink-muted);
  }
  .gate__legal {
    margin: calc(var(--space) * 2) 0 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .redact {
    display: none;
    width: 12ch;
    height: 1lh;
    vertical-align: top;
    background: var(--redact);
    border-radius: 1px;
  }
  /* Screen only, and only with JS (otherwise nobody could reach Giai mat). Print shows the name. */
  @media not print {
    :global(:root[data-js][data-mode="mat"]) .redact {
      display: inline-block;
    }
    :global(:root[data-js][data-mode="mat"]) .gate__legal-name {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .redact {
      border: 1px solid CanvasText;
    }
  }
  .gate__positioning {
    max-width: 40ch;
    /* Room for two lines whatever the wording or language: the card is centred, so a line count
       change on a language switch would move the codename (ROADMAP 10.4). */
    min-height: 2lh;
    margin: calc(var(--space) * 3) 0 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  /* A small tag on its own solid ground, so the grid never crosses it. */
  .gate__hint {
    justify-self: start;
    padding: calc(var(--space) * 0.5) var(--space);
    color: var(--ink-muted);
    background-color: var(--bg);
    border: 1px solid var(--line);
  }
</style>
