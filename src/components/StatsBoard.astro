---
// Header figures of the Giai mat "data floor" (ROADMAP 14.3, reworked in 20.3). Kept: the spread
// of entries over the evidence tiers, computed from content/claims.json. Added: the owner's result
// figures from content/metrics.json, each with the file code of the entry it comes from. Nothing
// is filled in here: with no metric, the block holds the tier spread alone. Mat does not show it.
import { t, type Locale } from "../lib/i18n";
import { tracedMetrics } from "../lib/metrics";
import type { Claim } from "../lib/schema";
import { tierSpread } from "../lib/stats";

interface Props {
  claims: Claim[];
  locale: Locale;
}
const { claims, locale } = Astro.props;
const tiers = tierSpread(claims);
const metrics = await tracedMetrics(claims);
const [heading, t3, source] = await Promise.all(["statsHeading", "statsT3", "metricSource"].map((k) => t(k, locale)));
const tierTotal = tiers.T1 + tiers.T2 + tiers.T3;
---

<section class="stats sheet sheet--block only-giai-mat" aria-labelledby="stats-heading" data-stats>
  <h2 id="stats-heading" class="stats__heading">{heading}</h2>
  <dl class="stats__grid">
    {
      metrics.map((m) => (
        <div class="stats__cell" data-stat="metric" data-metric={m.id}>
          <dt>{m.label[locale]}</dt>
          <dd>
            <span class="stats__num">
              {m.value.toLocaleString(locale === "vi" ? "vi-VN" : "en-GB")}
              {m.unit && <span class="stats__unit"> {m.unit[locale]}</span>}
            </span>
            <a class="stats__note stats__source" href={`#claim-${m.source}`}>
              {source}: {m.code}
            </a>
          </dd>
        </div>
      ))
    }
    <div class="stats__cell" data-stat="t3">
      <dt>{t3}</dt>
      <dd>
        <span class="stats__num">{tiers.T3}</span>
        {/* Spread over the tiers: width by count, and each tier has its own fill (not colour alone). */}
        {
          tierTotal > 0 && (
            <span class="stats__spread" aria-hidden="true">
              {(["T1", "T2", "T3"] as const)
                .filter((k) => tiers[k] > 0)
                .map((k) => (
                  <span class={`stats__seg stats__seg--${k}`} style={`flex-grow:${tiers[k]}`} />
                ))}
            </span>
          )
        }
        <span class="stats__note">
          T1 {tiers.T1} · T2 {tiers.T2} · T3 {tiers.T3}
        </span>
      </dd>
    </div>
  </dl>
</section>

<style>
  .stats__heading {
    margin: 0 0 calc(var(--space) * 2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--accent);
  }
  @media (min-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stats__cell {
    display: grid;
    align-content: start;
    gap: var(--space);
    padding: calc(var(--space) * 2) calc(var(--space) * 2) calc(var(--space) * 2) 0;
    border-bottom: 1px solid var(--line);
  }
  .stats__cell + .stats__cell {
    padding-inline-start: calc(var(--space) * 2);
    border-inline-start: 1px solid var(--line);
  }
  @media (max-width: 719px) {
    .stats__cell:nth-child(odd) {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }
  .stats__cell dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .stats__cell dd {
    display: grid;
    gap: calc(var(--space) * 0.75);
    margin: 0;
  }
  .stats__num {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stats__unit {
    font-size: 0.4em;
    letter-spacing: 0;
  }
  .stats__note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .stats__source {
    justify-self: start;
    text-underline-offset: 3px;
  }
  /* Tier spread: outline (T1), hatched (T2), solid (T3). */
  .stats__spread {
    display: flex;
    gap: 2px;
    height: 10px;
  }
  .stats__seg {
    border: 1px solid var(--accent);
  }
  .stats__seg--T2 {
    background: repeating-linear-gradient(135deg, var(--accent) 0 2px, transparent 2px 5px);
  }
  .stats__seg--T3 {
    background: var(--accent);
  }
  @media (forced-colors: active) {
    .stats__seg {
      border-color: CanvasText;
    }
    .stats__seg--T3 {
      background: CanvasText;
    }
  }
</style>
