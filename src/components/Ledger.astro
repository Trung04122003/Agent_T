---
// Ledger (SPEC sections 5-6, UX section 2): one row per public claim. Both modes always show org,
// title and period of open entries; Mat adds teaser + redaction, Giai mat adds summary + evidence.
// Classified entries only ever carry their category label.
import { t, type Locale } from "../lib/i18n";
import { tierOf, type Tier } from "../lib/evidence";
import { fileCode, formatPeriod, publicClaims } from "../lib/ledger";
import type { Claim } from "../lib/schema";
import PageMark from "./PageMark.astro";
import Redaction from "./Redaction.astro";

export interface LedgerLabels {
  heading: string;
  /** Legend lines for the evidence tiers (ROADMAP 9.7). */
  tiers: Record<Tier, string>;
  viewDeclassified: string;
  classifiedClosed: string;
  redacted: string;
  present: string;
  evidence: string;
}
interface Props {
  claims: Claim[];
  locale: Locale;
  labels: LedgerLabels;
  /** Dev only: badge entries the owner has not confirmed yet (SPEC section 6). */
  showUnverified: boolean;
  seed?: string;
}
const { claims, locale, labels, showUnverified, seed } = Astro.props;
const rows = publicClaims(claims);
const stamp = await t("stampOpened", locale);
---

<section class="ledger sheet sheet--block" aria-labelledby="ledger-heading" data-ledger>
  <PageMark locale={locale} page="ledger" />
  <h2 id="ledger-heading" class="ledger__heading">{labels.heading}<span class="ledger__lens" data-lens-title></span></h2>
  <ul class="ledger__legend" data-tier-legend>
    {(["T1", "T2", "T3"] as const).map((t) => <li>{labels.tiers[t]}</li>)}
  </ul>
  <ol class="ledger__list brackets">
    {
      rows.map((c, i) => {
        const code = fileCode(i);
        const panelId = `panel-${c.id}`;
        const period = c.period ? formatPeriod(c.period, labels.present) : null;

        if (c.kind === "classified") {
          return (
            <li class="row row--classified" id={`claim-${c.id}`} data-claim={c.id} data-kind="classified">
              <h3 class="row__head">
                <button class="row__toggle" type="button" aria-expanded="true" aria-controls={panelId} data-row-toggle>
                  <span class="row__code">{code}</span>
                  <span class="row__period" dir="ltr">{period}</span>
                  <span class="row__main">
                    <Redaction barKey={c.id} label={c.label[locale]} seed={seed} />
                  </span>
                </button>
              </h3>
              <div class="row__panel" id={panelId}>
                <div class="row__inner">
                  <p class="row__closed">{labels.classifiedClosed}</p>
                </div>
              </div>
            </li>
          );
        }

        const teaser = c.teaser?.[locale];
        const summary = c.summary?.[locale];
        const bluf = c.bluf?.[locale];
        const hasPanel = Boolean(teaser || summary || c.evidence.length);
        const cells = (
          <>
            <span class="row__code">{code}</span>
            <span class="row__period" dir="ltr">{period}</span>
            <span class="row__main">
              {c.org && <span class="row__org">{c.org[locale]}</span>}
              {c.title && <span class="row__title">{c.title[locale]}</span>}
              {/* Bottom line up front (ROADMAP 11.2): both modes, only when the owner wrote one. */}
              {bluf && <span class="row__bluf">{bluf}</span>}
            </span>
            <span class="row__tier" data-tier={tierOf(c.evidence)}>
              {labels.evidence} {tierOf(c.evidence)}
            </span>
            {showUnverified && c.status !== "confirmed" && <span class="row__badge">UNCONFIRMED</span>}
          </>
        );

        return (
          <li class="row" id={`claim-${c.id}`} data-claim={c.id} data-kind={c.kind}>
            <h3 class="row__head">
              {hasPanel ? (
                <button class="row__toggle" type="button" aria-expanded="true" aria-controls={panelId} data-row-toggle>
                  {cells}
                </button>
              ) : (
                <span class="row__static">{cells}</span>
              )}
            </h3>
            {hasPanel && (
              <div class="row__panel" id={panelId}>
                <div class="row__inner">
                  {/* Stamp on opening (ROADMAP 13.3), Mat only; decorative. */}
                  <p class="only-mat row__stamp" aria-hidden="true" data-stamp>
                    <span>{stamp}</span>
                    <span>{code}</span>
                  </p>
                  {/* Never both at once (ROADMAP 9.2): teaser is Mat only, summary is Giai mat only. */}
                  {teaser && <p class="only-mat row__teaser">{teaser}</p>}
                  {summary && (
                    <div class="only-mat row__redacted">
                      <Redaction barKey={c.id} label={labels.redacted} seed={seed} />
                      <a class="row__declassify" href={`#claim-${c.id}`} data-declassify={c.id}>
                        {labels.viewDeclassified}
                      </a>
                    </div>
                  )}
                  {summary && <p class="only-giai-mat row__summary">{summary}</p>}
                  {c.evidence.length > 0 && (
                    <div class="only-giai-mat row__evidence">
                      <p class="row__evidence-heading">{labels.evidence}</p>
                      <ul>
                        {c.evidence.map((e) => (
                          <li>{e.type === "link" && e.url ? <a href={e.url}>{e.note[locale]}</a> : e.note[locale]}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            )}
          </li>
        );
      })
    }
  </ol>
</section>

<script>
  import { initLedger } from "../scripts/ledger";
  initLedger();
</script>

<style>
  .ledger__heading,
  .row__code,
  .row__period,
  .row__tier,
  .row__badge,
  .ledger__legend,
  .row__evidence-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ledger__heading {
    margin: 0 0 calc(var(--space) * 2);
    color: var(--accent);
  }
  /* Current reading direction (P7), e.g. "Sổ cái · Đối tác". */
  .ledger__lens:not(:empty)::before {
    content: " · ";
  }
  .ledger__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--accent);
  }
  .row {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--space) * 2);
  }
  .row__head {
    margin: 0;
    font: inherit;
  }
  .row__toggle,
  .row__static {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr);
    gap: var(--space) calc(var(--space) * 2);
    align-items: baseline;
    width: 100%;
    min-height: var(--target);
    padding: calc(var(--space) * 2) 0;
    font: inherit;
    text-align: start;
    color: inherit;
    background: none;
    border: 0;
  }
  .row__toggle {
    cursor: pointer;
  }
  @media (min-width: 720px) {
    .row__toggle,
    .row__static {
      /* Wide enough for the price-board padding and rule (code 5ch, period 22ch). */
      grid-template-columns: 5ch 22ch minmax(0, 1fr) auto;
    }
  }
  /* Price-board columns (UX-v2 section 3): code and period read as a ticker table. */
  .row__code,
  .row__period {
    font-size: 0.875rem;
    color: var(--ink);
  }
  @media (min-width: 720px) {
    .row__code,
    .row__period {
      align-self: stretch;
      padding-inline-end: calc(var(--space) * 2);
      border-inline-end: 1px solid var(--line);
    }
  }
  .row__main {
    display: grid;
    gap: 2px;
    grid-column: 2 / -1;
  }
  @media (min-width: 720px) {
    .row__main {
      grid-column: auto;
    }
  }
  .row__org {
    font-weight: 700;
  }
  .row__title {
    color: var(--ink-muted);
  }
  .row__bluf {
    margin-top: calc(var(--space) * 0.5);
    max-width: var(--measure);
    color: var(--ink);
  }
  .row__tier,
  .row__badge {
    justify-self: start;
    padding: 2px 6px;
    border: 1px solid currentColor;
  }
  .row__tier {
    color: var(--accent);
    white-space: nowrap;
  }
  .ledger__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space) calc(var(--space) * 3);
    margin: 0 0 calc(var(--space) * 2);
    padding: 0;
    list-style: none;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-muted);
  }
  .row__badge {
    color: var(--ink-muted);
    border-style: dashed;
  }

  /* Open / close: grid-template-rows 0fr <-> 1fr (UX section 3). Without JS every row is open. */
  .row__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 250ms ease;
  }
  .row__inner {
    min-height: 0;
    overflow: hidden;
  }
  :global(:root[data-js]) .row:not(.is-open) .row__panel {
    grid-template-rows: 0fr;
  }
  :global(:root[data-js]) .row:not(.is-open) .row__inner {
    visibility: hidden;
  }
  @media print {
    :global(:root[data-js]) .row:not(.is-open) .row__panel {
      grid-template-rows: 1fr;
    }
    :global(:root[data-js]) .row:not(.is-open) .row__inner {
      visibility: visible;
    }
  }
  .row__inner > * {
    max-width: var(--measure);
    margin: 0 0 calc(var(--space) * 2);
  }
  @media (min-width: 720px) {
    .row__inner {
      padding-inline-start: calc(5ch + 22ch + var(--space) * 4);
    }
  }
  /* Stamp (ROADMAP 13.3): a double-ruled brass box set at an angle. In the flow on phones, in the
     free space right of the text on wide screens. Animated by ledger.ts on opening. */
  .row__stamp {
    display: inline-flex;
    align-items: center;
    gap: var(--space);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    border: 3px double var(--accent);
    rotate: -6deg;
  }
  .row__stamp span + span {
    padding-inline-start: var(--space);
    border-inline-start: 1px solid var(--accent);
  }
  .row__inner > .row__stamp {
    margin-block-start: var(--space);
  }
  @media (min-width: 1100px) {
    /* A column kept free for the stamp: text and redaction bars never run under it. */
    .row__inner {
      position: relative;
      padding-inline-end: 168px;
    }
    .row__inner > .row__stamp {
      position: absolute;
      top: var(--space);
      inset-inline-end: calc(var(--space) * 3);
      margin: 0;
    }
  }
  .row__redacted {
    display: grid;
    gap: var(--space);
  }
  .row__declassify,
  .row__evidence a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .row__declassify {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    min-height: var(--target);
    display: inline-flex;
    align-items: center;
  }
  .row__evidence ul {
    margin: var(--space) 0 0;
    padding-inline-start: 1.25em;
  }
  .row__closed {
    color: var(--ink-muted);
  }
</style>
