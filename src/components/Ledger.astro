---
// Ledger (SPEC sections 5-6, UX section 2): one row per public claim (LedgerRow.astro, shared with
// Agent T City's briefings). Classified entries only ever carry their category label.
import { t, type Locale } from "../lib/i18n";
import type { Tier } from "../lib/evidence";
import { fileCode, publicClaims } from "../lib/ledger";
import type { Claim } from "../lib/schema";
import { BUILT } from "../lib/dossier";
import { experienceBalance } from "../lib/stats";
import LedgerRow from "./LedgerRow.astro";
import TierMeter from "./TierMeter.astro";
import PageMark from "./PageMark.astro";

export interface LedgerLabels {
  heading: string;
  /** Legend lines for the evidence tiers (ROADMAP 9.7). */
  tiers: Record<Tier, string>;
  viewDeclassified: string;
  classifiedClosed: string;
  redacted: string;
  present: string;
  evidence: string;
}
interface Props {
  claims: Claim[];
  locale: Locale;
  labels: LedgerLabels;
  /** Dev only: badge entries the owner has not confirmed yet (SPEC section 6). */
  showUnverified: boolean;
  seed?: string;
}
const { claims, locale, labels, showUnverified, seed } = Astro.props;
const rows = publicClaims(claims);
// Giai mat "data floor" (ROADMAP 14.1): column heads (each row shows its own length, LedgerRow).
const [colCode, colPeriod, colEntry] = await Promise.all(["colCode", "colPeriod", "colEntry"].map((k) => t(k, locale)));
// Giai mat "truer" (ROADMAP 28.4, 28.6): the experience balance, its note here, each entry's own line in its row.
const balance = experienceBalance(claims, BUILT);
const balanceNote = await t("balanceNote", locale);
---

<section class="ledger sheet sheet--block" aria-labelledby="ledger-heading" data-ledger>
  <PageMark locale={locale} page="ledger" />
  <h2 id="ledger-heading" class="ledger__heading">{labels.heading}<span class="ledger__lens" data-lens-title></span></h2>
  <ul class="ledger__legend" data-tier-legend>
    {
      (["T1", "T2", "T3"] as const).map((t) => (
        <li>
          <TierMeter tier={t} always />
          {labels.tiers[t]}
        </li>
      ))
    }
  </ul>
  <p class="ledger__note only-giai-mat" data-balance-note>{balanceNote}</p>
  <div class="ledger__cols only-giai-mat" aria-hidden="true">
    <span>{colCode}</span>
    <span>{colPeriod}</span>
    <span>{colEntry}</span>
    <span>{labels.evidence}</span>
  </div>
  <ol class="ledger__list brackets">
    {
      rows.map((c, i) => (
        <LedgerRow claim={c} code={fileCode(i)} locale={locale} labels={labels} showUnverified={showUnverified} seed={seed} balance={balance.get(c.id)} />
      ))
    }
  </ol>
</section>

<script>
  import { initLedger } from "../scripts/ledger";
  initLedger();
</script>

<style>
  .ledger__heading,
  .ledger__legend {
    margin: calc(var(--space) * 1.5) 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .ledger__heading {
    margin: 0 0 calc(var(--space) * 2);
    color: var(--accent);
  }
  /* Current reading direction (P7), e.g. "Sổ cái · Đối tác". */
  .ledger__lens:not(:empty)::before {
    content: " · ";
  }
  .ledger__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--accent);
  }
  /* Tier legend (ROADMAP 20.6): the same bars in both modes, three columns, one on phones. */
  .ledger__legend {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space) calc(var(--space) * 3);
    margin: 0 0 calc(var(--space) * 2);
    padding: 0;
    list-style: none;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-muted);
  }
  @media (min-width: 720px) {
    .ledger__legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ledger__legend li {
    display: flex;
    align-items: flex-start;
    gap: var(--space);
  }
  .ledger__legend li :global(.tier-meter) {
    flex: none;
    margin-top: 2px;
  }
  /* Giai mat, "data floor" (ROADMAP 14.1): a table head over the columns, each entry's length in
     months under its dates, tighter rows than Mat, the tier as a bar (14.2). */
  .ledger__cols {
    display: none;
  }
  @media (min-width: 720px) {
    .ledger__cols {
      display: grid;
      grid-template-columns: 5ch 22ch minmax(0, 1fr) auto;
      gap: 0 calc(var(--space) * 2);
      padding-block-end: var(--space);
      /* Same font size as the rows, so the ch-based columns line up; the labels are smaller. */
      font-size: 1rem;
    }
    .ledger__cols span {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .ledger__cols span:nth-child(-n + 2) {
      padding-inline-end: calc(var(--space) * 2);
    }
    .ledger__cols span:last-child {
      text-align: end;
    }
    :global(:root[data-js][data-mode="mat"]) .ledger__cols {
      display: none;
    }
  }
  .ledger__note {
    margin: 0 0 calc(var(--space) * 2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
</style>
