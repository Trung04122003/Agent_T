---
// Agent T City route (ROADMAP-v4). Built only when CITY_ENABLED (src/lib/flags.ts). P31 stub: the
// real shell (noindex, canonical, district list, Lite view) comes in P33.
import Base from "../../../layouts/Base.astro";
import { CITY_ENABLED } from "../../../lib/flags";
import { t } from "../../../lib/i18n";
import { LOCALES, type Locale } from "../../../lib/locales";

export function getStaticPaths() {
  return CITY_ENABLED ? LOCALES.map((lang) => ({ params: { lang } })) : [];
}

const locale = Astro.params.lang as Locale;
const title = await t("cityTitle", locale);
const back = await t("cityBack", locale);
const stub = await t("cityStub", locale);
---

<Base locale={locale} title={title}>
  <section class="city-stub page" data-city>
    <h1>{title}</h1>
    <p>{stub}</p>
    <p><a href={`/${locale}/`}>{back}</a></p>
  </section>
</Base>
