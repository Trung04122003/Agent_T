---
import CommitChart from "../../components/CommitChart.astro";
import EvidenceFlow from "../../components/EvidenceFlow.astro";
import CapabilityMatrix from "../../components/CapabilityMatrix.astro";
import Gate from "../../components/Gate.astro";
import Ledger from "../../components/Ledger.astro";
import { ledgerLabels } from "../../lib/ledger-labels";
import LensNav from "../../components/LensNav.astro";
import Map from "../../components/Map.astro";
import OnePage from "../../components/OnePage.astro";
import PrintButton from "../../components/PrintButton.astro";
import RiskFactors from "../../components/RiskFactors.astro";
import StatsBoard from "../../components/StatsBoard.astro";
import Base from "../../layouts/Base.astro";
import { publicClaims } from "../../lib/ledger";
import { ledgerEntries } from "../../lib/ledger-entries";
import { LOCALES, type Locale } from "../../lib/locales";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const claims = await ledgerEntries();
const labels = await ledgerLabels(locale);
---

<Base locale={locale} title="Cupid Dossier" path="/" gate>
  <Gate locale={locale} />
  <StatsBoard claims={claims} locale={locale} />
  <LensNav locale={locale} publicIds={publicClaims(claims).map((c) => c.id)} />
  <Ledger claims={claims} locale={locale} labels={labels} showUnverified={import.meta.env.DEV} />
  <CommitChart claims={claims} locale={locale} />
  <EvidenceFlow claims={claims} locale={locale} />
  <CapabilityMatrix claims={claims} locale={locale} />
  <Map locale={locale} />
  <RiskFactors locale={locale} />
  <PrintButton locale={locale} />
  <OnePage claims={claims} locale={locale} />
</Base>
