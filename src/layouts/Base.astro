---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/motion.css";
import "../styles/cursor.css";
import LangSwitch from "../components/LangSwitch.astro";
import ModeToggle from "../components/ModeToggle.astro";
import ClassBanner from "../components/ClassBanner.astro";
import RequestDocs from "../components/RequestDocs.astro";
import { BUILT, fileNumber } from "../lib/dossier";
import { t, type Locale } from "../lib/i18n";
import { codenameFor, getIdentity } from "../lib/identity";
import { dirFor, localeReport, LOCALES } from "../lib/locales";
import { contentStrings } from "../lib/translations";
import { NOINDEX } from "../lib/site";
import { updatedStamp } from "../lib/updated";
import { CURSOR_KEY } from "../scripts/cursor";
import { GATE_KEY } from "../scripts/entry";
import { FONT_KEY, NIGHT_KEY, SIZE_KEY } from "../scripts/reading";
import ReadingPanel from "../components/ReadingPanel.astro";
import EntryGate from "../components/EntryGate.astro";
import { MODE_KEY } from "../scripts/mode";

interface Props {
  locale: Locale;
  title: string;
  /** Locale-free path of a page that exists in every locale; enables the language switch. */
  path?: string;
  /** Override text direction (dev RTL smoke test only). */
  dir?: "ltr" | "rtl";
  /** Offer the entry gate (ROADMAP P25): the file's home page only. */
  gate?: boolean;
}
const { locale, title, path, dir = dirFor(locale), gate = false } = Astro.props;
const updatedLabel = await t("updatedLabel", locale);
const updated = updatedStamp(new Date());
// Neutral SEO (ROADMAP 8.4): the positioning line from content/, nothing more.
const identity = await getIdentity();
const description = identity.positioning[locale];
const fileNo = fileNumber(codenameFor(identity, locale).name, BUILT);
const ogLocale = { vi: "vi_VN", en: "en_US" }[locale];
// Only complete languages are offered (ROADMAP 10.3; scripts/check-locales.mjs reports the rest).
const { strings, reviewed } = contentStrings();
const complete = new Set(localeReport(strings, reviewed).filter((r) => r.available).map((r) => r.locale));
const published = LOCALES.filter((l) => complete.has(l));

// Runs before first paint: mark JS as available (mode-dependent hiding only applies then, so the
// no-JS page shows all public content), then apply the saved mode. Default stays "mat".
// The cursor preference (ROADMAP 21.4) is read here too, so the right cursor is there from the
// first paint; blocked storage means the default ("custom").
// Entry gate (ROADMAP 25.1/25.6), decided here before the first paint: shown only with JS, on
// every load, a reload included (owner 2026-11-01, replacing "once a session"), except with a deep
// link (#...) or ?skip, or when the page is opened for printing. Nothing is stored any more: the
// session flag is only read, and only the test and measuring tools set it to go straight in.
const gateScript = `var g="show";try{if(sessionStorage.getItem(${JSON.stringify(GATE_KEY)}))g="skip"}catch(e){}if(location.hash||/[?&]skip(=|&|$)/.test(location.search)||matchMedia("print").matches)g="skip";document.documentElement.dataset.gate=g;`;
// Reading settings (ROADMAP 27.5), before the first paint too: no flash of the default face/size.
const readingScript = `try{var f=localStorage.getItem(${JSON.stringify(FONT_KEY)});if(f==="bien-ban"||f==="de-doc"||f==="may-chu")document.documentElement.dataset.font=f;var z=localStorage.getItem(${JSON.stringify(SIZE_KEY)});if(z==="sm"||z==="lg")document.documentElement.dataset.size=z;if(localStorage.getItem(${JSON.stringify(NIGHT_KEY)})==="off")document.documentElement.dataset.night="off"}catch(e){}`;
const modeScript = `${gate ? gateScript : ""}${readingScript}document.documentElement.dataset.js="";try{var m=localStorage.getItem(${JSON.stringify(MODE_KEY)});if(m==="mat"||m==="giai-mat")document.documentElement.dataset.mode=m}catch(e){}var c="custom";try{if(localStorage.getItem(${JSON.stringify(CURSOR_KEY)})==="system")c="system"}catch(e){}document.documentElement.dataset.cursor=c`;
---

<!doctype html>
<html lang={locale} dir={dir} data-mode="mat">
  <head>
    <script is:inline set:html={modeScript} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {NOINDEX && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {path !== undefined && published.map((l) => <link rel="alternate" hreflang={l} href={`/${l}${path}`} />)}
  </head>
  <body>
    <ClassBanner locale={locale} position="top" />
    <header class="controls">
      <div class="controls__start">{path !== undefined && <LangSwitch locale={locale} path={path} locales={published} />}<slot name="controls-start" /></div>
      <div class="controls__end">
        <ReadingPanel locale={locale} />
        <ModeToggle locale={locale} />
      </div>
    </header>
    <p class="visually-hidden" aria-live="polite" data-lang-live></p>
    <main id="main">
      <slot />
    </main>
    <footer class="footer sheet sheet--block">
      {/* ROADMAP 24.2: one general request at the end of the page, for the whole file. */}
      {path !== undefined && <RequestDocs locale={locale} fileRef={fileNo} />}
      <p class="footer__updated">{updatedLabel}: <time datetime={updated.iso}>{updated.text}</time></p>
    </footer>
    <ClassBanner locale={locale} position="bottom" />
    {gate && path !== undefined && <EntryGate locale={locale} path={path} locales={published} />}
    <script>
      // Cursor layer (ROADMAP P22): the gate decides; the layer's code is fetched only if allowed.
      import { initCursorFx } from "../scripts/cursor-loader";
      import { initRequest } from "../scripts/request";
      import { initStir } from "../scripts/stir";
      initCursorFx();
      initRequest();
      initStir();
    </script>
  </body>
</html>
